# ---- Server ----
SERVER_PORT=8080

# ---- MongoDB ----
# For local development, a plain standalone `mongod` is sufficient (no replica
# set required) â€” the app does not rely on multi-document transactions.
MONGODB_URI=mongodb://localhost:27017/qavzuro

# ---- JWT ----
# JWT_SECRET must be a long, random string (32+ chars) in any real deployment.
# The default below is for local development ONLY - never use it in production.
JWT_SECRET=CHANGE_ME_DEV_ONLY_MIN_32_CHARS_LONG_SECRET_KEY_1234
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=1209600000

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Rate limiting ----
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_REFILL=5
RATE_LIMIT_REGISTER_CAPACITY=3
RATE_LIMIT_REGISTER_REFILL=3
RATE_LIMIT_DEFAULT_CAPACITY=60
RATE_LIMIT_DEFAULT_REFILL=60

# ---- Dev/test seed data ----
# Set to false in production - do NOT seed a Master Admin account with a
# known password in a live environment.
SEED_ENABLED=false
MASTER_ADMIN_EMAIL=masteradmin@qavzuro.dev
MASTER_ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@qavzuro.dev
ADMIN_PASSWORD=ChangeMe123!
